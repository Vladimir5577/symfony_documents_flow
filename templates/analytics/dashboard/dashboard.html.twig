<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
    <title>ГУП ДНР «Донснабкомплект» — Дашборд</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('front_end/analytics_dashboard_style.css') }}">
</head>
<body>

<!-- HEADER -->
<header class="header">
    <a class="header-logo" href="/dashboard">
        <span class="org">ГУП ДНР</span>
        <span class="name">Донснабкомплект</span>
    </a>
    <div class="header-meta">
    </div>
</header>

<div class="content">

    <!-- FILIAL CARDS -->
    <div class="section-title">Филиалы</div>
    <div class="filial-grid" id="filialGrid">
        {% for organization in organizations %}
            <div class="filial-card {{ loop.first ? 'selected filial-hq' : '' }}" data-fil="{{ loop.index0 }}" data-org-id="{{ organization.id }}" onclick="selectFilial({{ loop.index0 }}, {{ organization.id }})">
                <div class="filial-name">{{ organization.name }}</div>
            </div>
        {% else %}
            <div class="filial-card selected filial-hq" data-fil="0">
                <div class="filial-name">Нет организаций верхнего уровня</div>
            </div>
        {% endfor %}
    </div>

    <!-- TAB NAVIGATION -->
    <div class="tabs-nav tabs-nav-main" id="tabsNav">
        <button class="tab-btn active" onclick="switchTab('finance')"><span class="ico">💰</span> Финансы</button>
    </div>
    <div class="tabs-nav" style="margin-top:8px;">
        <button id="scaleMonthBtn" class="tab-btn {{ initialScale == 'month' ? 'active' : '' }}" onclick="setScale('month')">По месяцам</button>
        <button id="scaleWeekBtn" class="tab-btn {{ initialScale == 'week' ? 'active' : '' }}" onclick="setScale('week')">По неделям</button>
    </div>

    <!-- ═══════════════════════ FINANCE ═══════════════════════ -->
    <div class="tab-panel active" id="tab-finance">
        <div class="card" style="margin-bottom:12px">
            <div class="card-title" style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
                <span>Динамика финансовых показателей</span>
                <span id="finSelectedPeriodLabel" style="font-size:11px;color:var(--text-muted)">Период: --</span>
            </div>
            <div class="chart-wrap"><canvas id="chartFinanceTrend"></canvas></div>
            <div style="margin-top:8px;font-size:11px;color:var(--text-muted)">Нажмите на точку периода, чтобы обновить snapshot ниже.</div>
        </div>
        <div
            id="finSnapshotTitle"
            style="
                margin: 10px 0 14px;
                padding: 12px 14px;
                border: 1px solid rgba(88,166,255,0.45);
                border-left: 4px solid #58a6ff;
                border-radius: 8px;
                background: linear-gradient(180deg, rgba(88,166,255,0.16), rgba(88,166,255,0.08));
                color: #dbe9ff;
                font-size: 16px;
                font-weight: 700;
                letter-spacing: 0.2px;
                line-height: 1.3;
            "
        >
            Срез за период: --
        </div>
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Дебиторская задолженность</div>
                <div class="stat-row"><span class="label">Итого</span><span class="value" id="finReceivableTotal">0 ₽</span></div>
            </div>
            <div class="card">
                <div class="card-title">Кредиторская задолженность</div>
                <div class="stat-row"><span class="label">Итого</span><span class="value" id="finPayableTotal">0 ₽</span></div>
            </div>
            <div class="card">
                <div class="card-title">Остатки на счетах</div>
                <div class="stat-row"><span class="label">Итого</span><span class="value" id="finBalanceTotal">0 ₽</span></div>
            </div>
        </div>
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Структура дебиторки</div>
                <div class="chart-wrap"><canvas id="chartFinanceReceivables"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Структура кредиторки</div>
                <div class="chart-wrap"><canvas id="chartFinancePayables"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Остатки по филиалам</div>
                <div class="chart-wrap"><canvas id="chartFinanceBranches"></canvas></div>
            </div>
        </div>
        <div class="card">
            <div class="card-title">Финансовые индикаторы</div>
            <div class="grid-3">
                <div class="stat-row"><span class="label">Дебиторка / Кредиторка</span><span class="value" id="finDebtorCreditorRatio">0</span></div>
                <div class="stat-row"><span class="label">Покрытие кредиторки остатками</span><span class="value" id="finBalanceCoverage">0%</span></div>
                <div class="stat-row"><span class="label">Чистая позиция (остатки - кредиторка)</span><span class="value" id="finNetPosition">0 ₽</span></div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ TKO ═══════════════════════ -->
    <div class="tab-panel" id="tab-tko">
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Динамика вывоза ТКО (тонн)</div>
                <div class="chart-wrap"><canvas id="chartTko"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Расход топлива (литры)</div>
                <div class="chart-wrap"><canvas id="chartFuelConsumption"></canvas></div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px">
        </div>
    </div>

    <!-- ═══════════════════════ CLIENTS ═══════════════════════ -->
    <div class="tab-panel" id="tab-clients">
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Начислено / Оплачено по месяцам</div>
                <div class="chart-wrap"><canvas id="chartBilling"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Собираемость по филиалам, %</div>
                <div class="chart-wrap"><canvas id="chartCollection"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Структура задолженности по срокам</div>
                <div class="chart-wrap"><canvas id="chartDebtAge"></canvas></div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Показатели — Население</div>
                <div class="stat-row"><span class="label">Начислено населению</span><span class="value">26 400 000 ₽</span></div>
                <div class="stat-row"><span class="label">Оплачено населением</span><span class="value">21 120 000 ₽</span></div>
                <div class="stat-row"><span class="label">Собираемость население</span><span class="value" style="color:var(--accent-amber)">80.0%</span></div>
                <div class="stat-row"><span class="label">Задолженность население</span><span class="value" style="color:var(--accent-amber)">14 200 000 ₽</span></div>
                <div class="stat-row"><span class="label">Просроченная задолженность</span><span class="value" style="color:var(--accent-red)">5 900 000 ₽</span></div>
                <div class="stat-row"><span class="label">Активных лицевых счетов</span><span class="value">84 200</span></div>
                <div class="stat-row"><span class="label">Лицевых счетов с долгом</span><span class="value" style="color:var(--accent-amber)">21 050</span></div>
                <div class="stat-row"><span class="label">Долг > 90 дней (счетов)</span><span class="value" style="color:var(--accent-red)">4 810</span></div>
                <div class="stat-row"><span class="label">Средняя задолженность/счет</span><span class="value">169 ₽</span></div>
            </div>
            <div class="card">
                <div class="card-title">Показатели — Юридические лица</div>
                <div class="stat-row"><span class="label">Начислено юрлицам</span><span class="value">16 220 000 ₽</span></div>
                <div class="stat-row"><span class="label">Оплачено юрлицами</span><span class="value">13 940 000 ₽</span></div>
                <div class="stat-row"><span class="label">Собираемость юрлица</span><span class="value" style="color:var(--accent-teal)">85.9%</span></div>
                <div class="stat-row"><span class="label">Задолженность юрлица</span><span class="value" style="color:var(--accent-amber)">5 200 000 ₽</span></div>
                <div class="stat-row"><span class="label">Просроченная задолженность</span><span class="value" style="color:var(--accent-red)">1 900 000 ₽</span></div>
                <div class="stat-row"><span class="label">Действующих договоров</span><span class="value">1 247</span></div>
                <div class="stat-row"><span class="label">Новые договоры (апрель)</span><span class="value" style="color:var(--accent-teal)">+12</span></div>
                <div class="stat-row"><span class="label">Расторгнутые договоры</span><span class="value" style="color:var(--accent-amber)">-3</span></div>
                <div class="stat-row"><span class="label">Долг на 1 договор (средн.)</span><span class="value">4 169 ₽</span></div>
            </div>
        </div>
        <div class="card">
            <div class="card-title">ТОП-5 крупнейших должников — юридические лица</div>
            <div class="branch-table-wrap">
                <table class="branch-table">
                    <thead><tr><th>Организация</th><th>Филиал</th><th>Долг, руб.</th><th>Просрочка</th><th>Статус</th></tr></thead>
                    <tbody>
                    <tr><td>ООО «Металл-Сервис»</td><td>Ф-3</td><td>420 000</td><td>90+ дней</td><td class="badge-bad">Критично</td></tr>
                    <tr><td>АО «Горпромстрой»</td><td>Ф-1</td><td>318 000</td><td>60 дней</td><td class="badge-warn">Внимание</td></tr>
                    <tr><td>МУП «Горкомхоз»</td><td>Ф-2</td><td>271 000</td><td>45 дней</td><td class="badge-warn">Внимание</td></tr>
                    <tr><td>ООО «Транс Плюс»</td><td>Ф-5</td><td>198 000</td><td>30 дней</td><td class="badge-warn">Умеренно</td></tr>
                    <tr><td>ИП Сидоренко А.В.</td><td>Ф-6</td><td>142 000</td><td>25 дней</td><td class="badge-ok">Активен</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ HR ═══════════════════════ -->
    <div class="tab-panel" id="tab-hr">
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Принятые / Уволенные по месяцам</div>
                <div class="chart-wrap"><canvas id="chartHiringFiring"></canvas></div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Кадровые показатели</div>
                <div class="stat-row"><span class="label">Штатная численность</span><span class="value" id="statStaffPlanned">--</span></div>
                <div class="stat-row"><span class="label">Фактическая численность</span><span class="value" id="statStaffActual" style="color:var(--accent-amber)">--</span></div>
                <div class="stat-row"><span class="label">Открытых вакансий</span><span class="value" id="statVacancies" style="color:var(--accent-red)">--</span></div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ COMPLAINTS ═══════════════════════ -->
    <div class="tab-panel" id="tab-complaints">
        <div class="grid-3" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Динамика жалоб</div>
                <div class="chart-wrap"><canvas id="chartComplaints"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Жалобы по филиалам</div>
                <div class="chart-wrap"><canvas id="chartComplFilial"></canvas></div>
            </div>
            <div class="card">
                <div class="card-title">Категории жалоб</div>
                <div style="padding-top:6px" class="cat-bars">
                    <div class="cat-bar-row"><span class="cat-bar-label">Невывоз ТКО</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:82%;background:var(--accent-red)"></div></div><span class="cat-bar-val">48</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">Переполн. контейнер</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:54%;background:var(--accent-amber)"></div></div><span class="cat-bar-val">32</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">Нарушение графика</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:42%;background:var(--accent-amber)"></div></div><span class="cat-bar-val">25</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">Начисления / квит.</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:32%;background:var(--accent-blue)"></div></div><span class="cat-bar-val">19</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">КГО</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:22%;background:var(--accent-cyan)"></div></div><span class="cat-bar-val">13</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">Работа водителя</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:15%;background:var(--accent-purple)"></div></div><span class="cat-bar-val">9</span></div>
                    <div class="cat-bar-row"><span class="cat-bar-label">Сост. контейн. площ.</span><div class="cat-bar-track"><div class="cat-bar-fill" style="width:10%;background:var(--text-muted)"></div></div><span class="cat-bar-val">2</span></div>
                </div>
            </div>
        </div>
        <div class="grid-2" style="margin-bottom:12px">
            <div class="card">
                <div class="card-title">Показатели обращений</div>
                <div class="stat-row"><span class="label">Поступило жалоб (апрель)</span><span class="value">148</span></div>
                <div class="stat-row"><span class="label">Отработано жалоб</span><span class="value" style="color:var(--accent-teal)">132</span></div>
                <div class="stat-row"><span class="label">Не отработано</span><span class="value" style="color:var(--accent-red)">16</span></div>
                <div class="stat-row"><span class="label">% отработки</span><span class="value" style="color:var(--accent-teal)">89.2%</span></div>
                <div class="stat-row"><span class="label">Просроченные жалобы</span><span class="value" style="color:var(--accent-amber)">11</span></div>
                <div class="stat-row"><span class="label">Среднее время закрытия</span><span class="value">1.8 дня</span></div>
                <div class="stat-row"><span class="label">Повторные жалобы</span><span class="value" style="color:var(--accent-amber)">22 (14.9%)</span></div>
                <div class="stat-row"><span class="label">Жалоб на 1000 абонентов</span><span class="value">1.76</span></div>
                <div class="stat-row"><span class="label">Жалоб на 100 рейсов</span><span class="value">5.21</span></div>
            </div>
            <div class="card">
                <div class="card-title">Проблемные зоны</div>
                <div class="risk-list">
                    <div class="risk-item" style="--item-color:var(--accent-red)">
                        <div class="risk-dot"></div>
                        <div class="risk-text">16 жалоб не отработаны — нарушение регламента</div>
                        <span class="risk-branch">Ф-3</span>
                    </div>
                    <div class="risk-item" style="--item-color:var(--accent-red)">
                        <div class="risk-dot"></div>
                        <div class="risk-text">48 жалоб на невывоз — системная проблема</div>
                        <span class="risk-branch">Ф-5, Ф-6</span>
                    </div>
                    <div class="risk-item" style="--item-color:var(--accent-amber)">
                        <div class="risk-dot"></div>
                        <div class="risk-text">Повторные жалобы растут (+4 к прош. месяцу)</div>
                        <span class="risk-branch">Ф-3</span>
                    </div>
                    <div class="risk-item" style="--item-color:var(--accent-amber)">
                        <div class="risk-dot"></div>
                        <div class="risk-text">Среднее время закрытия превысило норму</div>
                        <span class="risk-branch">Ф-6</span>
                    </div>
                    <div class="risk-item" style="--item-color:var(--accent-teal)">
                        <div class="risk-dot"></div>
                        <div class="risk-text">Ф-1 Донецк — лучший % отработки 97.3%</div>
                        <span class="risk-branch">Ф-1</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════ COMPARE ═══════════════════════ -->
    <div class="tab-panel" id="tab-compare">
        <div class="card" style="margin-bottom:12px">
            <div class="card-title" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px">
                <span>Сводная таблица сравнения филиалов</span>
                <div style="display:flex;align-items:center;gap:8px">
                    <div class="scale-toggle-compare" style="display:inline-flex;border-radius:6px;overflow:hidden;border:1px solid var(--border)">
                        <button class="scale-btn-cmp active" data-scale="month" onclick="setCompareScale('month')">Месяц</button>
                        <button class="scale-btn-cmp" data-scale="week" onclick="setCompareScale('week')">Неделя</button>
                    </div>
                    <select id="comparePeriodSelect" onchange="loadCompareData()" style="background:var(--card);color:var(--text);border:1px solid var(--border);border-radius:6px;padding:4px 8px;font-size:12px;font-family:inherit;cursor:pointer"></select>
                </div>
            </div>
            <div class="branch-table-wrap">
                <table class="branch-table">
                    <thead>
                    <tr>
                        <th>Филиал</th>
                        <th>Выручка, М₽</th>
                        <th>Расходы, М₽</th>
                        <th>ТКО, т</th>
                        <th>ГСМ, М₽</th>
                        <th>Штат план</th>
                        <th>Штат факт</th>
                        <th>Принято</th>
                        <th>Уволено</th>
                    </tr>
                    </thead>
                    <tbody id="compareTableBody">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div><!-- /content -->

<!-- BOTTOM NAV (mobile) -->
<nav class="bottom-nav">
    <button class="bnav-btn active" onclick="switchTab('finance');setActiveNav(this)">
        <span class="ico">💰</span>Финансы
    </button>
    <button class="bnav-btn" onclick="switchTab('compare');setActiveNav(this)">
        <span class="ico">📊</span>Свод
    </button>
</nav>

<script>
    /* ── DATA ── */
    let dashboardData = {{ dashboardDataJson|raw }};
    let currentTab = 'finance';
    let currentScale = '{{ initialScale|default('month') }}';

    /* ── TABS ── */
    function switchTab(id) {
        currentTab = id;
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.getElementById('tab-' + id).classList.add('active');
        const btns = document.querySelectorAll('.tab-btn');
        const map = { finance:0, tko:1, hr:2, compare:3 };
        if (btns[map[id]]) btns[map[id]].classList.add('active');
        renderTab(id);
    }

    function setActiveNav(el) {
        document.querySelectorAll('.bnav-btn').forEach(b => b.classList.remove('active'));
        el.classList.add('active');
    }

    function selectFilial(idx, orgId) {
        document.querySelectorAll('.filial-card').forEach(c => c.classList.remove('selected'));
        document.querySelector(`[data-fil="${idx}"]`).classList.add('selected');
        loadDashboardData(orgId);
    }

    /* ── AJAX LOAD ── */
    function loadDashboardData(orgId) {
        fetch('/analytics/dashboard/data?org_id=' + orgId + '&scale=' + currentScale)
            .then(r => r.json())
            .then(data => {
                dashboardData = data;
                renderAllTabs();
                updateHrStats();
            });
    }

    function getSelectedOrgId() {
        const selected = document.querySelector('.filial-card.selected');
        if (!selected) return 0;
        const raw = selected.getAttribute('data-org-id');
        return raw ? parseInt(raw, 10) : 0;
    }

    function setScale(scale) {
        currentScale = (scale === 'week') ? 'week' : 'month';
        const monthBtn = document.getElementById('scaleMonthBtn');
        const weekBtn = document.getElementById('scaleWeekBtn');
        if (monthBtn) monthBtn.classList.toggle('active', currentScale === 'month');
        if (weekBtn) weekBtn.classList.toggle('active', currentScale === 'week');
        loadDashboardData(getSelectedOrgId());
    }

    /* ── CHART.JS DEFAULTS ── */
    Chart.defaults.color = '#8b949e';
    Chart.defaults.borderColor = 'rgba(255,255,255,0.06)';
    Chart.defaults.font.family = "'IBM Plex Sans', sans-serif";
    Chart.defaults.font.size = 11;
    const FILIALS = ['Ф-1','Ф-2','Ф-3','Ф-4','Ф-5','Ф-6'];
    const moneyFmt = new Intl.NumberFormat('ru-RU', { style: 'currency', currency: 'RUB', maximumFractionDigits: 2 });

    function formatMoney(v) {
        return moneyFmt.format(Number(v || 0));
    }

    function mkChart(id, cfg) {
        const el = document.getElementById(id);
        if (!el) return;
        if (el._chart) { el._chart.destroy(); el._chart = null; }
        el._chart = new Chart(el, cfg);
    }

    /* ── UPDATE HR STATS ── */
    function updateHrStats() {
        const hr = dashboardData.hr || {};
        const sp = document.getElementById('statStaffPlanned');
        const sa = document.getElementById('statStaffActual');
        const sv = document.getElementById('statVacancies');
        if (sp) sp.textContent = hr.staffPlanned || '--';
        if (sa) sa.textContent = hr.staffActual || '--';
        if (sv) sv.textContent = hr.vacancies || '--';
    }

    /* ── RENDER ── */
    function renderAllTabs() {
        renderTab('finance');
        renderTab('tko');
        renderTab('hr');
        renderTab('compare');
    }

    function renderTab(id) {
        if (chartRenderers[id]) chartRenderers[id]();
    }

    function xLabels() {
        return dashboardData.labels || dashboardData.monthLabels || [];
    }

    const chartRenderers = {
        finance: () => {
            const labels = xLabels();
            const fin = dashboardData.finance || {};
            const trends = fin.trends || {};
            const recSeries = fin.receivablesBreakdownSeries || {};
            const paySeries = fin.payablesBreakdownSeries || {};
            const branchesSeries = fin.branchesBreakdownSeries || [];

            const receivableTotalEl = document.getElementById('finReceivableTotal');
            const payableTotalEl = document.getElementById('finPayableTotal');
            const balanceTotalEl = document.getElementById('finBalanceTotal');
            const ratioEl = document.getElementById('finDebtorCreditorRatio');
            const coverageEl = document.getElementById('finBalanceCoverage');
            const netPositionEl = document.getElementById('finNetPosition');
            const periodLabelEl = document.getElementById('finSelectedPeriodLabel');
            const snapshotTitleEl = document.getElementById('finSnapshotTitle');

            const pick = (arr, idx) => Number((arr && arr[idx] != null) ? arr[idx] : 0);
            let selectedIdx = Math.max(0, labels.length - 1);

            const renderSnapshotByIndex = (idx) => {
                selectedIdx = idx;
                const receivableTotal = pick(trends.receivableTotal, idx);
                const payableTotal = pick(trends.payableTotal, idx);
                const balanceTotal = pick(trends.balanceTotal, idx);
                const ratio = payableTotal > 0 ? (receivableTotal / payableTotal) : 0;
                const coverage = payableTotal > 0 ? ((balanceTotal / payableTotal) * 100) : 0;
                const netPosition = balanceTotal - payableTotal;

                if (receivableTotalEl) receivableTotalEl.textContent = formatMoney(receivableTotal);
                if (payableTotalEl) payableTotalEl.textContent = formatMoney(payableTotal);
                if (balanceTotalEl) balanceTotalEl.textContent = formatMoney(balanceTotal);
                if (ratioEl) ratioEl.textContent = ratio.toFixed(2);
                if (coverageEl) coverageEl.textContent = coverage.toFixed(1) + '%';
                if (netPositionEl) netPositionEl.textContent = formatMoney(netPosition);
                const periodLabel = labels[idx] || '--';
                if (periodLabelEl) periodLabelEl.textContent = 'Период: ' + periodLabel;
                if (snapshotTitleEl) {
                    snapshotTitleEl.textContent = currentScale === 'month'
                        ? ('Срез: среднее за месяц ' + periodLabel)
                        : ('Срез за период: ' + periodLabel);
                }

                mkChart('chartFinanceReceivables', {
                    type: 'doughnut',
                    data: {
                        labels: ['Население (ТКО)', 'Юридические лица (ТКО)'],
                        datasets: [{
                            data: [pick(recSeries.populationTkoExport, idx), pick(recSeries.legalEntitiesTko, idx)],
                            backgroundColor: ['#58a6ff', '#39c5cf'],
                            borderWidth: 0
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, cutout: '62%' }
                });

                mkChart('chartFinancePayables', {
                    type: 'bar',
                    data: {
                        labels: ['Подрядчики ТКО', 'Полигоны', 'ГСМ', 'Прочее'],
                        datasets: [{
                            label: 'Сумма, ₽',
                            data: [
                                pick(paySeries.contractorsTkoExport, idx),
                                pick(paySeries.landfillsMaintenance, idx),
                                pick(paySeries.fuel, idx),
                                pick(paySeries.otherGoodsServices, idx),
                            ],
                            backgroundColor: ['#f85149', '#d29922', '#f59e0b', '#8b949e'],
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { x: { ticks: { callback: v => Math.round(v / 1_000_000) + 'М' } } }
                    }
                });

                mkChart('chartFinanceBranches', {
                    type: 'bar',
                    data: {
                        labels: branchesSeries.map(b => b.name),
                        datasets: [{
                            label: 'Остаток, ₽',
                            data: branchesSeries.map(b => pick(b.values || [], idx)),
                            backgroundColor: 'rgba(88,166,255,0.75)',
                            borderRadius: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { ticks: { callback: v => Math.round(v / 1_000_000) + 'М' } } }
                    }
                });
            };

            const trendCanvas = document.getElementById('chartFinanceTrend');
            mkChart('chartFinanceTrend', {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Дебиторка', data: trends.receivableTotal || [], borderColor: '#58a6ff', backgroundColor: 'rgba(88,166,255,0.1)', fill: false, tension: 0.3, pointRadius: 4 },
                        { label: 'Кредиторка', data: trends.payableTotal || [], borderColor: '#f85149', backgroundColor: 'rgba(248,81,73,0.08)', fill: false, tension: 0.3, pointRadius: 4 },
                        { label: 'Остатки', data: trends.balanceTotal || [], borderColor: '#39c5cf', backgroundColor: 'rgba(57,197,207,0.08)', fill: false, tension: 0.3, pointRadius: 4 },
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { position: 'bottom' } },
                    scales: { y: { ticks: { callback: v => Math.round(v / 1_000_000) + 'М' } } },
                }
            });

            if (trendCanvas && trendCanvas._chart) {
                trendCanvas.onclick = (evt) => {
                    const points = trendCanvas._chart.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, true);
                    if (points.length > 0) {
                        renderSnapshotByIndex(points[0].index);
                    }
                };
            }

            renderSnapshotByIndex(selectedIdx);
        },
        tko: () => {
            const labels = xLabels();
            const tko = dashboardData.tko || {};
            mkChart('chartTko', {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Вывезено, т', data: tko.tkoExport || [], borderColor: '#39c5cf', backgroundColor: 'rgba(57,197,207,0.1)', fill: true, tension: 0.4, pointRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
            mkChart('chartFuelConsumption', {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Расход топлива, л', data: tko.fuelConsumption || [], borderColor: '#f59e0b', backgroundColor: 'rgba(245,158,11,0.12)', fill: true, tension: 0.35, pointRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        },
        hr: () => {
            const labels = xLabels();
            const hr = dashboardData.hr || {};
            mkChart('chartHiringFiring', {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Принято', data: hr.hired || [], backgroundColor: 'rgba(63,185,80,0.7)', borderRadius: 4 },
                        { label: 'Уволено', data: hr.terminated || [], backgroundColor: 'rgba(248,81,73,0.6)', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        },
        clients: () => {
            const labels = xLabels();
            mkChart('chartBilling', {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Начислено', data: [], backgroundColor: 'rgba(88,166,255,0.6)', borderRadius: 4 },
                        { label: 'Оплачено', data: [], backgroundColor: 'rgba(63,185,80,0.7)', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
            mkChart('chartCollection', {
                type: 'bar',
                data: {
                    labels: FILIALS,
                    datasets: [
                        { label: 'Население, %', data: [], backgroundColor: 'rgba(88,166,255,0.7)', borderRadius: 4 },
                        { label: 'Юрлица, %', data: [], backgroundColor: 'rgba(57,197,207,0.7)', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } }, scales: { y: { min: 60, max: 100, ticks: { callback: v => v+'%' } } } }
            });
            mkChart('chartDebtAge', {
                type: 'doughnut',
                data: {
                    labels: ['До 30 дней','31–60 дней','61–90 дней','Более 90 дней'],
                    datasets: [{ data: [38,22,14,26], backgroundColor: ['#3fb950','#d29922','#f0883e','#f85149'], borderWidth: 0 }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } }, cutout: '60%' }
            });
        },
        complaints: () => {
            const labels = xLabels();
            mkChart('chartComplaints', {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'Поступило', data: [], borderColor: '#f85149', backgroundColor: 'rgba(248,81,73,0.1)', fill: true, tension: 0.4, pointRadius: 4 },
                        { label: 'Отработано', data: [], borderColor: '#3fb950', backgroundColor: 'rgba(63,185,80,0.05)', fill: true, tension: 0.4, pointRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
            mkChart('chartComplFilial', {
                type: 'bar',
                data: {
                    labels: FILIALS,
                    datasets: [
                        { label: 'Поступило', data: [], backgroundColor: 'rgba(248,81,73,0.6)', borderRadius: 4 },
                        { label: 'Закрыто', data: [], backgroundColor: 'rgba(63,185,80,0.7)', borderRadius: 4 }
                    ]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
            });
        },
        compare: () => {
            renderCompareTable(dashboardData.compare || {});
        }
    };

    /* ── COMPARE TAB ── */
    let compareScale = '{{ initialScale }}';

    function setCompareScale(scale) {
        compareScale = scale;
        document.querySelectorAll('.scale-btn-cmp').forEach(b => b.classList.toggle('active', b.dataset.scale === scale));
        loadCompareData();
    }

    function loadCompareData() {
        const orgId = getSelectedOrgId();
        const sel = document.getElementById('comparePeriodSelect');
        let url = '/analytics/dashboard/compare-data?org_id=' + orgId + '&scale=' + compareScale;
        if (sel && sel.value) {
            const parts = sel.value.split('-');
            url += '&year=' + parts[0] + '&period=' + parts[1];
        }
        fetch(url)
            .then(r => r.json())
            .then(data => {
                dashboardData.compare = data;
                renderCompareTable(data);
            });
    }

    function renderCompareTable(data) {
        const sel = document.getElementById('comparePeriodSelect');
        const tbody = document.getElementById('compareTableBody');
        if (!sel || !tbody) return;

        // Update period selector
        const periods = data.availablePeriods || [];
        const currentVal = sel.value || (data.selectedYear + '-' + data.selectedPeriod);
        sel.innerHTML = '';
        periods.forEach(p => {
            const opt = document.createElement('option');
            opt.value = p.year + '-' + p.period;
            opt.textContent = p.label;
            if (opt.value === String(data.selectedYear) + '-' + String(data.selectedPeriod)) opt.selected = true;
            sel.appendChild(opt);
        });

        // Update table rows
        const rows = data.rows || [];
        tbody.innerHTML = '';
        if (rows.length === 0) {
            tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:var(--text-muted);padding:24px">Нет данных за выбранный период</td></tr>';
            return;
        }
        rows.forEach(row => {
            const tr = document.createElement('tr');
            if (row.isTotal) tr.classList.add('hq');
            tr.innerHTML =
                '<td>' + (row.isTotal ? '\uD83C\uDFE2 ' : '') + row.name + '</td>' +
                '<td>' + row.cashInflow + '</td>' +
                '<td>' + row.cashOutflow + '</td>' +
                '<td>' + row.tkoExport.toLocaleString('ru-RU') + '</td>' +
                '<td>' + row.fuelConsumption + '</td>' +
                '<td>' + row.staffPlanned + '</td>' +
                '<td>' + row.staffActual + '</td>' +
                '<td>' + row.hired + '</td>' +
                '<td>' + row.terminated + '</td>';
            tbody.appendChild(tr);
        });
    }

    /* ── INIT ── */
    window.addEventListener('load', () => {
        updateHrStats();
        renderTab('finance');
    });
</script>
</body>
</html>
