{% extends 'base_dashboard.html.twig' %}

{% block title %}Заполнение ТС{% endblock %}

{% block sidebar_list %}
    {% include 'sidebar/sidebar_list.html.twig' %}
{% endblock %}

{% block main %}
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <h3>Заполнение ТС</h3>
                <p class="text-subtitle text-muted">Справочник мусоровозов для аналитики ТКО</p>
            </div>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <section class="section">
        <style>
            @media (min-width: 1200px) {
                .tko-vehicles-form-col { flex: 0 0 20%; max-width: 20%; }
                .tko-vehicles-grid-col { flex: 0 0 80%; max-width: 80%; }
            }
        </style>
        <div class="row">
            <div class="col-12 col-xl-3 mb-4 tko-vehicles-form-col">
                <div class="card" id="vehicle-form-card">
                    <div class="card-header">
                        <h5 class="mb-0">{{ editing ? 'Редактирование ТС' : 'Новое ТС' }}</h5>
                    </div>
                    <div class="card-body">
                        <form method="post" action="{{ path('app_analytics_tko_vehicles_save') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('analytics_tko_vehicle_save') }}">
                            {% if editing %}
                                <input type="hidden" name="vehicle_id" value="{{ editing.id }}">
                            {% endif %}

                            <div class="mb-3">
                                <label class="form-label" for="vehicle-name">Наименование <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vehicle-name" name="name" required maxlength="255"
                                       value="{{ editing ? editing.name : '' }}">
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="vehicle-license">Госномер <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vehicle-license" name="license_number" required maxlength="64"
                                       value="{{ editing ? editing.licenseNumber : '' }}">
                                <div class="form-text">Сохраняется без пробелов, в верхнем регистре.</div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="vehicle-volume">Объём кузова, м³</label>
                                    <input type="text" class="form-control" id="vehicle-volume" name="volume" inputmode="decimal"
                                           value="{{ editing and editing.volume is not null ? editing.volume|tko_decimal : '' }}">
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" for="vehicle-compaction">Коэф. уплотнения</label>
                                    <input type="text" class="form-control" id="vehicle-compaction" name="compaction_ratio" inputmode="decimal"
                                           value="{{ editing and editing.compactionRatio is not null ? editing.compactionRatio|tko_decimal : '' }}">
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="vehicle-polygon">Полигон <span class="text-danger">*</span></label>
                                <select class="form-select" id="vehicle-polygon" name="polygon_id" required>
                                    <option value="">— выберите —</option>
                                    {% for polygon in polygons %}
                                        <option value="{{ polygon.id }}"
                                            {% if editing and editing.polygon and editing.polygon.id == polygon.id %}selected{% endif %}>
                                            {{ polygon.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="vehicle-filial">Филиал <span class="text-danger">*</span></label>
                                <select class="form-select" id="vehicle-filial" name="organization_id" required>
                                    <option value="">— выберите —</option>
                                    {% for filial in filials %}
                                        <option value="{{ filial.id }}"
                                            {% if editing and editing.organization and editing.organization.id == filial.id %}selected{% endif %}>
                                            {{ filial.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="form-check mb-4">
                                <input class="form-check-input" type="checkbox" name="is_active" value="1" id="vehicle-active"
                                       {% if editing is null or editing.isActive %}checked{% endif %}>
                                <label class="form-check-label" for="vehicle-active">В работе</label>
                            </div>

                            <div class="d-flex gap-2">
                                {% if editing %}
                                    <a href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page })) }}"
                                       class="btn btn-light-secondary flex-fill">Отменить</a>
                                {% endif %}
                                <button type="submit" class="btn btn-primary flex-fill">
                                    {{ editing ? 'Сохранить' : 'Добавить ТС' }}
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-9 mb-4 tko-vehicles-grid-col">
                <div class="card mb-3">
                    <div class="card-header">
                        <h5 class="mb-0">Фильтры</h5>
                    </div>
                    <div class="card-body">
                        <form method="get" class="row g-3 align-items-end">
                            {% if editing %}
                                <input type="hidden" name="edit" value="{{ editing.id }}">
                            {% endif %}
                            <div class="col-md-4">
                                <label class="form-label mb-1" for="filter-organization">Филиал</label>
                                <select class="form-select form-select-sm" id="filter-organization" name="organization_id">
                                    <option value="">Все</option>
                                    {% for filial in filials %}
                                        <option value="{{ filial.id }}" {% if filters.organization_id == filial.id %}selected{% endif %}>
                                            {{ filial.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label mb-1" for="filter-polygon">Полигон</label>
                                <select class="form-select form-select-sm" id="filter-polygon" name="polygon_id">
                                    <option value="">Все</option>
                                    {% for polygon in polygons %}
                                        <option value="{{ polygon.id }}" {% if filters.polygon_id == polygon.id %}selected{% endif %}>
                                            {{ polygon.name }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-4 d-flex gap-2 justify-content-end">
                                <a href="{{ path('app_analytics_tko_vehicles', editing ? { edit: editing.id } : {}) }}"
                                   class="btn btn-outline-secondary btn-sm">Сбросить</a>
                                <button type="submit" class="btn btn-primary btn-sm">Применить</button>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h5 class="mb-0">Справочник</h5>
                        <span class="badge bg-secondary">Всего: {{ pagination.total_items }}</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-striped table-hover mb-0">
                                <thead>
                                <tr>
                                    <th>Госномер</th>
                                    <th>Наименование</th>
                                    <th class="text-end">Объём, м³</th>
                                    <th class="text-end">Коэф.</th>
                                    <th class="text-end">Ёмкость, м³</th>
                                    <th>Полигон</th>
                                    <th>Филиал</th>
                                    <th>Статус</th>
                                    <th></th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for vehicle in vehicles %}
                                    {% set capacity = (vehicle.volume is not null and vehicle.compactionRatio is not null)
                                        ? (vehicle.volume * vehicle.compactionRatio)
                                        : null %}
                                    <tr class="{{ vehicle.isActive ? '' : 'table-secondary' }}">
                                        <td class="fw-semibold">{{ vehicle.licenseNumber }}</td>
                                        <td>{{ vehicle.name }}</td>
                                        <td class="text-end">{{ vehicle.volume is not null ? vehicle.volume|tko_decimal : '—' }}</td>
                                        <td class="text-end">{{ vehicle.compactionRatio is not null ? vehicle.compactionRatio|tko_decimal : '—' }}</td>
                                        <td class="text-end">{{ capacity is not null ? capacity|tko_decimal : '—' }}</td>
                                        <td>{{ vehicle.polygon ? vehicle.polygon.name : '—' }}</td>
                                        <td>{{ vehicle.organization ? vehicle.organization.name : '—' }}</td>
                                        <td>{{ vehicle.isActive ? 'В работе' : 'Снята' }}</td>
                                        <td class="text-end text-nowrap">
                                            <form method="post"
                                                  action="{{ path('app_analytics_tko_vehicles_delete', { id: vehicle.id }) }}"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Удалить ТС {{ vehicle.licenseNumber|e('js') }}?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('analytics_tko_vehicle_delete_' ~ vehicle.id) }}">
                                                <input type="hidden" name="page" value="{{ pagination.current_page }}">
                                                <button type="submit" class="btn btn-sm btn-light-danger" title="Удалить">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            <a href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ edit: vehicle.id, page: pagination.current_page })) }}#vehicle-form-card"
                                               class="btn btn-sm btn-light-primary"
                                               title="Редактировать">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center text-muted py-4">Нет записей. Добавьте первое ТС слева.</td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                    {% if pagination.total_pages > 1 %}
                        <div class="card-footer">
                            <nav aria-label="Страницы справочника ТС">
                                <ul class="pagination justify-content-center mb-2">
                                    <li class="page-item {% if pagination.current_page == 1 %}disabled{% endif %}">
                                        <a class="page-link"
                                           href="{% if pagination.current_page > 1 %}{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page - 1 })) }}{% else %}#{% endif %}">
                                            «
                                        </a>
                                    </li>
                                    {% set start_page = max(1, pagination.current_page - 2) %}
                                    {% set end_page = min(pagination.total_pages, pagination.current_page + 2) %}
                                    {% if start_page > 1 %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: 1 })) }}">1</a>
                                        </li>
                                        {% if start_page > 2 %}
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        {% endif %}
                                    {% endif %}
                                    {% for p in start_page..end_page %}
                                        <li class="page-item {% if p == pagination.current_page %}active{% endif %}">
                                            <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: p })) }}">{{ p }}</a>
                                        </li>
                                    {% endfor %}
                                    {% if end_page < pagination.total_pages %}
                                        {% if end_page < pagination.total_pages - 1 %}
                                            <li class="page-item disabled"><span class="page-link">…</span></li>
                                        {% endif %}
                                        <li class="page-item">
                                            <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.total_pages })) }}">{{ pagination.total_pages }}</a>
                                        </li>
                                    {% endif %}
                                    <li class="page-item {% if pagination.current_page == pagination.total_pages %}disabled{% endif %}">
                                        <a class="page-link"
                                           href="{% if pagination.current_page < pagination.total_pages %}{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page + 1 })) }}{% else %}#{% endif %}">
                                            »
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                            <div class="text-center text-muted small">
                                Страница {{ pagination.current_page }} из {{ pagination.total_pages }}
                                ({{ ((pagination.current_page - 1) * pagination.items_per_page) + 1 }}–{{ min(pagination.current_page * pagination.items_per_page, pagination.total_items) }}
                                из {{ pagination.total_items }})
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
