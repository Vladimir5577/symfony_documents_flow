{% extends 'base_dashboard.html.twig' %}

{% block title %}Заполнение ТС{% endblock %}

{% block sidebar_list %}
    {% include 'sidebar/sidebar_list.html.twig' %}
{% endblock %}

{% block main %}
    <div class="page-title">
        <div class="row">
            <div class="col-12">
                <h3>Заполнение ТС</h3>
                <p class="text-subtitle text-muted">Справочник мусоровозов для аналитики ТКО</p>
            </div>
        </div>
    </div>

    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'warning' ? 'warning' : 'success') }} alert-dismissible">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
    {% endfor %}

    <section class="section">
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">Фильтры</h5>
                {% if editing %}
                    <a href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ open: 1 })) }}" class="btn btn-primary btn-sm">
                        <i class="bi bi-plus-lg"></i> Добавить ТС
                    </a>
                {% else %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#vehicleFormModal">
                        <i class="bi bi-plus-lg"></i> Добавить ТС
                    </button>
                {% endif %}
            </div>
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label mb-1" for="filter-organization">Филиал</label>
                        <select class="form-select form-select-sm" id="filter-organization" name="organization_id">
                            <option value="">Все</option>
                            {% for filial in filials %}
                                <option value="{{ filial.id }}" {% if filters.organization_id == filial.id %}selected{% endif %}>
                                    {{ filial.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-6 d-flex gap-2 justify-content-end">
                        <a href="{{ path('app_analytics_tko_vehicles') }}" class="btn btn-outline-secondary btn-sm">Сбросить</a>
                        <button type="submit" class="btn btn-primary btn-sm">Применить</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">Справочник</h5>
                <span class="badge bg-secondary">Всего: {{ pagination.total_items }}</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                        <tr>
                            <th>Госномер</th>
                            <th>Модель</th>
                            <th>Тип</th>
                            <th class="text-end">Объём, м³</th>
                            <th class="text-end">Коэф.</th>
                            <th class="text-end">Ёмкость, м³</th>
                            <th>Водитель</th>
                            <th>Филиал</th>
                            <th>Статус</th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for vehicle in vehicles %}
                            {% set capacity = (vehicle.volume is not null and vehicle.compactionRatio is not null)
                                ? (vehicle.volume * vehicle.compactionRatio)
                                : null %}
                            <tr class="{{ vehicle.status.value == 'active' ? '' : 'table-secondary' }}">
                                <td class="fw-semibold">{{ vehicle.licenseNumber }}</td>
                                <td>{{ vehicle.model }}</td>
                                <td>{{ vehicle.type }}</td>
                                <td class="text-end">{{ vehicle.volume is not null ? vehicle.volume|tko_decimal : '—' }}</td>
                                <td class="text-end">{{ vehicle.compactionRatio is not null ? vehicle.compactionRatio|tko_decimal : '—' }}</td>
                                <td class="text-end">{{ capacity is not null ? capacity|tko_decimal : '—' }}</td>
                                <td>
                                    {% if vehicle.driver %}
                                        {{ vehicle.driver.lastname }} {{ vehicle.driver.firstname }}
                                    {% else %}
                                        —
                                    {% endif %}
                                </td>
                                <td>{{ vehicle.organization ? vehicle.organization.name : '—' }}</td>
                                <td>{{ vehicle.status.label }}</td>
                                <td class="text-end text-nowrap">
                                    <form method="post"
                                          action="{{ path('app_analytics_tko_vehicles_delete', { id: vehicle.id }) }}"
                                          class="d-inline"
                                          onsubmit="return confirm('Удалить ТС {{ vehicle.licenseNumber|e('js') }}?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('analytics_tko_vehicle_delete_' ~ vehicle.id) }}">
                                        <input type="hidden" name="page" value="{{ pagination.current_page }}">
                                        <button type="submit" class="btn btn-sm btn-light-danger" title="Удалить">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                    <a href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ edit: vehicle.id, page: pagination.current_page })) }}"
                                       class="btn btn-sm btn-light-primary"
                                       title="Редактировать">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="10" class="text-center text-muted py-4">Нет записей. Нажмите «Добавить ТС».</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if pagination.total_pages > 1 %}
                <div class="card-footer">
                    <nav aria-label="Страницы справочника ТС">
                        <ul class="pagination justify-content-center mb-2">
                            <li class="page-item {% if pagination.current_page == 1 %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{% if pagination.current_page > 1 %}{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page - 1 })) }}{% else %}#{% endif %}">
                                    «
                                </a>
                            </li>
                            {% set start_page = max(1, pagination.current_page - 2) %}
                            {% set end_page = min(pagination.total_pages, pagination.current_page + 2) %}
                            {% if start_page > 1 %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: 1 })) }}">1</a>
                                </li>
                                {% if start_page > 2 %}
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                {% endif %}
                            {% endif %}
                            {% for p in start_page..end_page %}
                                <li class="page-item {% if p == pagination.current_page %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: p })) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            {% if end_page < pagination.total_pages %}
                                {% if end_page < pagination.total_pages - 1 %}
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                {% endif %}
                                <li class="page-item">
                                    <a class="page-link" href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.total_pages })) }}">{{ pagination.total_pages }}</a>
                                </li>
                            {% endif %}
                            <li class="page-item {% if pagination.current_page == pagination.total_pages %}disabled{% endif %}">
                                <a class="page-link"
                                   href="{% if pagination.current_page < pagination.total_pages %}{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page + 1 })) }}{% else %}#{% endif %}">
                                    »
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <div class="text-center text-muted small">
                        Страница {{ pagination.current_page }} из {{ pagination.total_pages }}
                        ({{ ((pagination.current_page - 1) * pagination.items_per_page) + 1 }}–{{ min(pagination.current_page * pagination.items_per_page, pagination.total_items) }}
                        из {{ pagination.total_items }})
                    </div>
                </div>
            {% endif %}
        </div>
    </section>

    <div class="modal fade" id="vehicleFormModal" tabindex="-1" aria-labelledby="vehicleFormModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <form method="post" action="{{ path('app_analytics_tko_vehicles_save') }}" enctype="multipart/form-data">
                    <div class="modal-header">
                        <h5 class="modal-title" id="vehicleFormModalLabel">
                            {{ editing ? 'Редактирование ТС' : 'Новое ТС' }}
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="_token" value="{{ csrf_token('analytics_tko_vehicle_save') }}">
                        {% if editing %}
                            <input type="hidden" name="vehicle_id" value="{{ editing.id }}">
                        {% endif %}

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-license">Госномер <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vehicle-license" name="license_number" required maxlength="64"
                                       value="{{ editing ? editing.licenseNumber : '' }}">
                                <div class="form-text">Без пробелов, верхний регистр.</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-status">Статус <span class="text-danger">*</span></label>
                                <select class="form-select" id="vehicle-status" name="status" required>
                                    {% for status in statuses %}
                                        <option value="{{ status.value }}"
                                            {% if editing %}
                                                {% if editing.status == status %}selected{% endif %}
                                            {% elseif status.value == 'active' %}
                                                selected
                                            {% endif %}>
                                            {{ status.label }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-model">Модель <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vehicle-model" name="model" required maxlength="255"
                                       value="{{ editing ? editing.model : '' }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-type">Тип <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="vehicle-type" name="type" required maxlength="255"
                                       value="{{ editing ? editing.type : '' }}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="vehicle-filial">Филиал</label>
                            <select class="form-select" id="vehicle-filial" name="organization_id">
                                <option value="">— не указан —</option>
                                {% for filial in filials %}
                                    <option value="{{ filial.id }}"
                                        {% if editing and editing.organization and editing.organization.id == filial.id %}selected{% endif %}>
                                        {{ filial.name }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="vehicle-volume">Объём кузова, м³</label>
                                <input type="text" class="form-control" id="vehicle-volume" name="volume" inputmode="decimal"
                                       value="{{ editing and editing.volume is not null ? editing.volume|tko_decimal : '' }}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="vehicle-compaction">Коэф. уплотнения</label>
                                <input type="text" class="form-control" id="vehicle-compaction" name="compaction_ratio" inputmode="decimal"
                                       value="{{ editing and editing.compactionRatio is not null ? editing.compactionRatio|tko_decimal : '' }}">
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label" for="vehicle-fuel">Норма расхода топлива</label>
                                <input type="text" class="form-control" id="vehicle-fuel" name="fuel_consumption_norm" inputmode="decimal"
                                       value="{{ editing and editing.fuelConsumptionNorm is not null ? editing.fuelConsumptionNorm|tko_decimal : '' }}">
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-driver">Водитель</label>
                                <select class="form-select" id="vehicle-driver" name="driver_id">
                                    <option value="">— не указан —</option>
                                    {% for driver in drivers %}
                                        <option value="{{ driver.id }}"
                                            {% if editing and editing.driver and editing.driver.id == driver.id %}selected{% endif %}>
                                            {{ driver.lastname }} {{ driver.firstname }}{% if driver.patronymic %} {{ driver.patronymic }}{% endif %}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="vehicle-write-off">Плановое списание</label>
                                <input type="date" class="form-control" id="vehicle-write-off" name="planned_write_off"
                                       value="{{ editing and editing.plannedWriteOff ? editing.plannedWriteOff|date('Y-m-d') : '' }}">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="vehicle-docs">Документы ТС</label>
                            {% if editing and vehicleDocs|length > 0 %}
                                <ul class="list-group mb-2">
                                    {% for doc in vehicleDocs %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2 py-2">
                                            <a href="{{ path('app_analytics_tko_vehicles_attachment_download', { id: doc.id }) }}" class="text-truncate">
                                                {{ doc.filename }}
                                            </a>
                                            <button type="submit" class="btn btn-sm btn-light-danger" title="Удалить"
                                                    form="delete-attachment-{{ doc.id }}"
                                                    onclick="return confirm('Удалить файл?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            <input type="file" class="form-control" id="vehicle-docs" name="vehicle_files[]" multiple>
                        </div>

                        <div class="mb-0">
                            <label class="form-label" for="internal-docs">Документы внутренние</label>
                            {% if editing and internalDocs|length > 0 %}
                                <ul class="list-group mb-2">
                                    {% for doc in internalDocs %}
                                        <li class="list-group-item d-flex justify-content-between align-items-center gap-2 py-2">
                                            <a href="{{ path('app_analytics_tko_vehicles_attachment_download', { id: doc.id }) }}" class="text-truncate">
                                                {{ doc.filename }}
                                            </a>
                                            <button type="submit" class="btn btn-sm btn-light-danger" title="Удалить"
                                                    form="delete-attachment-{{ doc.id }}"
                                                    onclick="return confirm('Удалить файл?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                            <input type="file" class="form-control" id="internal-docs" name="internal_files[]" multiple>
                        </div>
                    </div>
                    <div class="modal-footer">
                        {% if editing %}
                            <a href="{{ path('app_analytics_tko_vehicles', filter_query|merge({ page: pagination.current_page })) }}"
                               class="btn btn-light-secondary">Отменить</a>
                        {% else %}
                            <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">Отменить</button>
                        {% endif %}
                        <button type="submit" class="btn btn-primary">
                            {{ editing ? 'Сохранить' : 'Добавить ТС' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {% if editing %}
        {% for doc in vehicleDocs|merge(internalDocs) %}
            <form id="delete-attachment-{{ doc.id }}" method="post"
                  action="{{ path('app_analytics_tko_vehicles_attachment_delete', { id: doc.id }) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('analytics_tko_vehicle_attachment_delete_' ~ doc.id) }}">
            </form>
        {% endfor %}
    {% endif %}

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modalEl = document.getElementById('vehicleFormModal');
            if (!modalEl || !window.bootstrap) {
                return;
            }
            {% if editing or app.request.query.get('open') == '1' %}
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
            {% endif %}
        });
    </script>
{% endblock %}
